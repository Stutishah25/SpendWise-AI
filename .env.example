# Copy to .env (never commit .env). Values below are local-development placeholders only.
POSTGRES_USER=spendwise
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=spendwise
DATABASE_URL=postgresql+psycopg://spendwise:change-me-locally@localhost:5432/spendwise
# Test-suite admin connection (needs CREATEDB; tests create and drop throw-away databases)
TEST_ADMIN_URL=postgresql+psycopg://spendwise:change-me-locally@localhost:5432/postgres

# Authentication / JWT settings
JWT_SECRET_KEY=change-me-locally-to-a-secure-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
